      { "block_id": "h-install", "kind": "heading", "text": "室内配电安装要求", "metadata": { "outline_level": 0 }, "locator": { "scheme": "section", "value": "1" } },
      { "block_id": "install-scope", "kind": "paragraph", "text": "以下要求适用于室内低压配电柜。", "locator": { "scheme": "paragraph", "value": "1.0" } },
      { "block_id": "install-r1", "kind": "list_item", "text": "1. 施工方必须检查保护接地连续性。", "metadata": { "list_id": "install-requirements", "parent_clause_id": "install-scope" }, "locator": { "scheme": "paragraph", "value": "1.1", "page": 2 } },
      { "block_id": "install-r2", "kind": "list_item", "text": "2. 施工方必须记录绝缘电阻；但经设计单位书面批准的测试点除外。", "metadata": { "list_id": "install-requirements", "parent_clause_id": "install-scope" }, "locator": { "scheme": "paragraph", "value": "1.2", "page": 2 } },

      { "block_id": "h-start", "kind": "heading", "text": "循环泵启动程序", "metadata": { "outline_level": 0 }, "locator": { "scheme": "section", "value": "2" } },
      { "block_id": "start-1", "kind": "list_item", "text": "1. 打开入口阀。", "metadata": { "list_id": "pump-start", "knowledge_event_type": "procedure", "sequence": 1 }, "locator": { "scheme": "paragraph", "value": "2.1", "page": 3 } },
      { "block_id": "start-2", "kind": "list_item", "text": "2. 点动电机并确认旋向。", "metadata": { "list_id": "pump-start", "knowledge_event_type": "procedure", "sequence": 2 }, "locator": { "scheme": "paragraph", "value": "2.2", "page": 3 } },
      { "block_id": "start-3", "kind": "list_item", "text": "3. 缓慢开启出口阀并记录压力。", "metadata": { "list_id": "pump-start", "knowledge_event_type": "procedure", "sequence": 3 }, "locator": { "scheme": "paragraph", "value": "2.3", "page": 3 } },
      { "block_id": "h-storage", "kind": "heading", "text": "仓储安全", "metadata": { "outline_level": 0 }, "locator": { "scheme": "section", "value": "3" } },
      { "block_id": "storage-1", "kind": "paragraph", "text": "仓库通道不得堆放包装材料。", "locator": { "scheme": "paragraph", "value": "3.1", "page": 3 } },

      { "block_id": "h-table", "kind": "heading", "text": "风机运行参数", "metadata": { "outline_level": 0 }, "locator": { "scheme": "section", "value": "4" } },
