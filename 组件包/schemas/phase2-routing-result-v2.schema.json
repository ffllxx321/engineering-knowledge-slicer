{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering-knowledge-slicer://schema/phase2-routing-result-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_document_id", "document_role", "confidence", "reasons", "review_reasons", "resolved"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "source_document_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "library": { "enum": ["active_tender", "business"] },
    "directory_category": { "type": "string", "minLength": 1, "maxLength": 120 },
    "document_role": { "enum": ["source_record", "instruction", "submission", "correspondence", "meeting_record", "commercial_record", "technical_record", "contract_record", "reference", "unknown"] },
    "supersedes_document_id": { "type": "string", "maxLength": 300 },
    "replaces_document_id": { "type": "string", "maxLength": 300 },
    "version_label": { "type": "string", "maxLength": 300 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasons": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 300 } },
    "review_reasons": { "type": "array", "uniqueItems": true, "maxItems": 6, "items": { "enum": ["ambiguous_project", "ambiguous_category", "conflicting_facts", "missing_evidence", "unsupported_invented_facts", "reuse_promotion"] } },
    "resolved": { "type": "boolean" }
  }
}
