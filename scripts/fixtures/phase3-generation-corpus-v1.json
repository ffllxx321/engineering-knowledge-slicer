      { "block_id": "table-a", "kind": "table_row", "text": "送风机 A | 不超过 80 | 不超过 4.5", "metadata": { "table_id": "fan-parameters", "row_id": "fan-a", "table_headers": ["设备", "轴承温度 (°C)", "振动速度 (mm/s)"] }, "locator": { "scheme": "table", "value": "4.A", "page": 4, "row": 2 } },

