      { "block_id": "water-pressure", "kind": "paragraph", "text": "冷却水供水压力不得低于 0.25 MPa。", "locator": { "scheme": "paragraph", "value": "6.1", "page": 6 } },
      { "block_id": "h-air", "kind": "heading", "text": "仪表空气供气压力", "metadata": { "outline_level": 0 }, "locator": { "scheme": "section", "value": "7" } },
      { "block_id": "air-pressure", "kind": "paragraph", "text": "仪表空气供气压力不得低于 0.55 MPa。", "locator": { "scheme": "paragraph", "value": "7.1", "page": 6 } },

