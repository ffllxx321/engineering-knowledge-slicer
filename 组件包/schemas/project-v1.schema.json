{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering-knowledge-slicer://schema/project-1.0",
  "title": "项目",
  "type": "object",
  "required": ["schema_version", "record_kind", "record_id", "title", "library", "state", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_kind": { "const": "project" },
    "record_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "library": { "enum": ["active_tender", "business"] },
    "state": { "enum": ["lead", "approved", "bidding", "submitted", "evaluating", "won", "lost", "paused", "terminated", "contracted", "archived"] },
    "archive_outcome": { "enum": ["won_completed", "lost", "terminated", "paused_by_decision"] },
    "archive_decided_at": { "type": "string", "minLength": 1 },
    "source_document_ids": { "$ref": "#/$defs/ids" },
    "business_item_ids": { "$ref": "#/$defs/ids" },
    "company_knowledge_ids": { "$ref": "#/$defs/ids" },
    "related_item_ids": { "$ref": "#/$defs/ids" },
    "supersedes_id": { "type": "string", "minLength": 1 },
    "replaces_id": { "type": "string", "minLength": 1 },
    "derived_from_ids": { "$ref": "#/$defs/ids" },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "$defs": { "ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } }
}
